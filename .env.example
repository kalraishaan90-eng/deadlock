PORT=3000

# Google Project Config
GOOGLE_PROJECT_ID=workkoutapp
GOOGLE_STORAGE_BUCKET=workkoutapp.firebasestorage.app

# Google iOS OAuth Credentials
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
GOOGLE_IOS_REVERSED_CLIENT_ID=com.googleusercontent.apps.your-ios-client-id
GOOGLE_IOS_APP_ID=1:your-project-number:ios:your-app-id
GOOGLE_IOS_BUNDLE_ID=com.example.workoutapp

# Google Android OAuth Credentials
GOOGLE_ANDROID_APP_ID=1:your-project-number:android:your-app-id
GOOGLE_ANDROID_PACKAGE=com.physique.workoutapp

# Comma-separated list of allowed OAuth Client IDs for server token verification
ALLOWED_GOOGLE_CLIENT_IDS=your-ios-client-id.apps.googleusercontent.com

# Gemini AI Studio API Key for server-side AI food & macro lookup
GEMINI_API_KEY=
